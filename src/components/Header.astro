---
import { asset } from '../lib/url';
---
<header class="sticky top-0 z-20 bg-white shadow-[0_2px_8px_rgba(0,0,0,.06)]">
  <!-- La franja roja va dentro del header para que quede fija al bajar -->
  <div class="h-4 bg-brand"></div>
  <div class="container-x grid h-[72px] grid-cols-[auto_1fr] items-center md:h-24 md:grid-cols-[1fr_auto_1fr]">
    <label class="hidden items-center gap-4 text-sm text-placeholder md:flex">
      <svg class="text-brand" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <span class="sr-only">Buscar</span>
      <input type="search" placeholder="Buscar por código, marca..." class="w-[200px] border-0 text-text outline-0 placeholder:text-placeholder" />
    </label>
    <a href={asset('')}>
      <img src={asset('assets/logo-electrodiesel.svg')} alt="Electro Diesel – todo para tu auto" class="h-10 w-auto md:h-[52px]" />
    </a>
    <div class="flex justify-end gap-5 text-brand">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-label="Mi cuenta"><circle cx="12" cy="8" r="4" /><path d="M5 21a7 7 0 0 1 14 0" /></svg>
      <svg width="24" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-label="Carrito"><path d="M2 3h3l2.4 11.2a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L21 7H6" /><circle cx="10" cy="20" r="1.3" /><circle cx="18" cy="20" r="1.3" /></svg>
    </div>
  </div>
</header>
