---
import { VACANTES } from '../data/vacantes';
---
<dialog id="jobModal" aria-labelledby="mTitle"
  class="modal m-auto max-h-[calc(100dvh-48px)] w-[min(720px,100%-32px)] rounded-3xl border-0 p-0 text-text shadow-[0_30px_80px_rgba(0,0,0,.25)]">
  <div class="flex max-h-[inherit] flex-col">
    <div class="border-b border-line px-[22px] pt-8 pb-6 md:px-10">
      <div class="mb-3.5 flex items-start justify-between gap-4">
        <h2 id="mTitle" class="text-[23px] font-bold tracking-tight text-ink md:text-[28px]"></h2>
        <button id="mClose" aria-label="Cerrar" class="grid size-10 flex-none place-items-center rounded-full bg-soft text-ink hover:bg-[#e9e9e9]">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12" /></svg>
        </button>
      </div>
      <div id="mMeta" class="flex flex-wrap gap-2"></div>
    </div>
    <div class="modal-body overflow-y-auto px-[22px] py-7 md:px-10">
      <h4>Tu desafío</h4>
      <p id="mDesafio" class="mb-7 leading-[1.65]"></p>
      <h4>Requisitos</h4>
      <ul id="mReqs" class="grid gap-3"></ul>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line px-[22px] pt-5 pb-7 md:px-10">
      <small class="text-muted">¿Te identificás con este perfil?</small>
      <button id="mApply" class="btn btn-primary max-md:flex-1">
        Postularme a esta vacante
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M19 12l-7 7-7-7" /></svg>
      </button>
    </div>
  </div>
</dialog>

<script is:inline type="application/json" id="vacantes-json" set:html={JSON.stringify(VACANTES)} />

<script>
  import type { Vacante } from '../data/vacantes';
  const vacantes: Vacante[] = JSON.parse(document.getElementById('vacantes-json')!.textContent!);
  const modal = document.getElementById('jobModal') as HTMLDialogElement;
  const $ = (id: string) => document.getElementById(id)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
  const tag = (txt: string, icon = '') =>
    `<span class="inline-flex items-center gap-2 rounded-full bg-[#EFEFEF] px-3 py-1.5 text-[13px] font-semibold text-text">${icon}${esc(txt)}</span>`;
  const check = '<svg class="mt-0.5 text-brand" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" fill="currentColor" stroke="none" opacity=".12"/><path d="m8 12.5 2.8 2.8L16.5 9.5"/></svg>';
  let current: Vacante | undefined;

  window.addEventListener('vacante:abrir', (e) => {
    current = vacantes.find((v) => v.id === (e as CustomEvent<string>).detail);
    if (!current) return;
    $('mMeta').innerHTML = tag(current.area) + tag(current.tipo) + tag(current.ciudad);
    $('mTitle').textContent = current.titulo;
    $('mDesafio').textContent = current.desafio;
    $('mReqs').innerHTML = current.requisitos.map((r) => `<li class="grid grid-cols-[22px_1fr] gap-3 leading-normal">${check}<span>${esc(r)}</span></li>`).join('');
    modal.showModal();
    modal.querySelector('.modal-body')!.scrollTop = 0;
  });
  $('mClose').onclick = () => modal.close();
  modal.addEventListener('click', (e) => { if (e.target === modal) modal.close(); });
  $('mApply').onclick = () => {
    modal.close();
    if (current) window.dispatchEvent(new CustomEvent('vacante:postular', { detail: current }));
  };
</script>
