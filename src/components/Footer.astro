---
const cols = [
  { titulo: 'NOSOTROS', links: ['Sobre la empresa', 'Nuestras sucursales', 'Contacto'] },
  { titulo: 'EMPRESA', links: ['Nuestros horarios', 'Trabajá con nosotros', 'Política de privacidad'] },
];
---
<footer class="bg-footer pt-16 pb-7 text-white">
  <div class="container-x">
    <div class="grid gap-9 md:grid-cols-[repeat(3,minmax(0,1fr))] md:gap-0">
      {cols.map((c) => (
        <div class="border-b border-brand pb-7 md:mr-10 md:border-r md:border-b-0 md:pr-6 md:pb-0">
          <h4 class="mb-7 text-2xl font-semibold tracking-[.01em]">{c.titulo}</h4>
          <ul class="grid gap-[22px] text-sm font-light">
            {c.links.map((l) => <li><a href="#" class="hover:text-[#ff9a9e]">{l}</a></li>)}
          </ul>
        </div>
      ))}
      <div>
        <h4 class="mb-7 text-2xl font-semibold tracking-[.01em]">INFORMACIÓN</h4>
        <ul class="grid gap-[22px] text-sm font-light [overflow-wrap:anywhere] [&_svg]:flex-none [&_svg]:text-brand [&>li]:flex [&>li]:items-center [&>li]:gap-3">
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z" /></svg>
            <span>Línea Gratuita <b class="font-bold">0800 11 76 76</b></span>
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="3" /></svg>
            Avda. Eusebio Ayala c/Camilo Recalde
          </li>
          <li>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="2" y="4" width="20" height="16" rx="2" /><path d="m22 7-10 6L2 7" /></svg>
            centrodeatencion@electrodiesel.com.py
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-[72px] mb-8 flex items-center gap-5 before:mr-1 before:h-px before:flex-1 before:bg-brand md:before:max-w-[45%] md:before:flex-none md:before:basis-[540px]">
      <a href="#" aria-label="Instagram" class="grid size-10 place-items-center rounded-full bg-brand">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="#fff" /></svg>
      </a>
      <a href="#" aria-label="Facebook" class="grid size-10 place-items-center rounded-full bg-brand">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M15 3h-2.5A3.5 3.5 0 0 0 9 6.5V9H7v3h2v9h3v-9h2.5l.5-3h-3V6.8c0-.5.4-.8.8-.8H15V3Z" /></svg>
      </a>
    </div>
    <div class="flex flex-wrap items-center gap-3 text-sm font-light">
      Design and development by <b class="font-bold">G DIGITAL</b><span class="h-7 w-px bg-[#777]"></span>Todos los derechos reservados.
    </div>
  </div>
</footer>

<a href="#" aria-label="WhatsApp" class="fixed right-4 bottom-[84px] z-15 grid size-[50px] place-items-center rounded-full border-2 border-white bg-[#25D366] shadow-[0_6px_18px_rgba(0,0,0,.2)] md:right-6 md:bottom-28 md:size-14 xl:right-20">
  <svg width="28" height="28" viewBox="0 0 24 24" fill="#fff"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7.5-.1 1.5-.6 1.8-1.2.2-.6.2-1.1.1-1.2l-.5-.3Z" /></svg>
</a>
<a href="#" id="toTop" aria-label="Volver arriba" class="pointer-events-none fixed right-4 bottom-5 z-15 grid size-[50px] place-items-center rounded-full border-2 border-white bg-brand opacity-0 shadow-[0_6px_18px_rgba(0,0,0,.2)] transition-opacity data-[show]:pointer-events-auto data-[show]:opacity-100 md:right-6 md:bottom-9 md:size-14 xl:right-20">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
</a>

<script>
  const toTop = document.getElementById('toTop')!;
  addEventListener('scroll', () => toTop.toggleAttribute('data-show', scrollY > 600), { passive: true });
  toTop.addEventListener('click', (e) => { e.preventDefault(); scrollTo({ top: 0, behavior: 'smooth' }); });
</script>
